# Anthropic API key powers the pet's brain (chat + personality + memory).
# Without it, the pet falls back to a deterministic local stub so the MVP still runs.
ANTHROPIC_API_KEY=

# Optional override for the model. Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Simulated AGI/USD price oracle. The MVP fakes a Chainlink feed by reading this.
AGI_PRICE_USD=0.05
